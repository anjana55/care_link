# Database (local MySQL - see docker-compose.yml)
DATABASE_URL="mysql://care_app:care_app_password@localhost:3306/care_platform"

# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Verification-link targets - must be listed in CORS_ORIGIN above too.
# CAREGIVER_WEB_URL: staff/caregiver app (apps/web).
# PUBLIC_WEB_URL: public patient/guardian app (apps/public-web).
CAREGIVER_WEB_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3002

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Storage (local filesystem abstraction - see storage.module.ts)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=../../storage/caregiver-documents
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
