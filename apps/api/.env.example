# Database (local MySQL - see docker-compose.yml)
DATABASE_URL="mysql://care_app:care_app_password@localhost:3306/care_platform"

# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Verification-link targets - must be listed in CORS_ORIGIN above too.
# CAREGIVER_WEB_URL: staff/caregiver app (apps/web), which is mounted
# under /staff (see apps/web/next.config.js's basePath) - the /staff
# suffix here is required, not optional, or caregiver verification links
# will 404.
# PUBLIC_WEB_URL: public patient/guardian app (apps/public-web).
CAREGIVER_WEB_URL=http://localhost:3000/staff
PUBLIC_WEB_URL=http://localhost:3002

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Storage (local filesystem abstraction - see storage.module.ts)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=../../storage/caregiver-documents
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email (SMTP) - leave SMTP_HOST blank for local dev: verification emails
# just get logged to the console instead of sent, and the API still
# returns a devVerificationUrl field in both register responses (see
# both apps' register pages) so the flow stays testable without a mailbox.
# Fill these in to actually test real delivery locally, e.g. against
# Mailtrap, Mailhog, or a real provider's SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CareLink <no-reply@care-platform.local>"

# WhatsApp sign-in (alternative to email for users without an email address).
# The feature is configured in the admin UI (Settings > WhatsApp sign-in); these
# only seed the settings the first time the API starts. Leave all blank for
# local dev: turn the feature on in the admin UI with the "Console" provider
# and OTP codes are logged to the API console (and echoed back as `devOtp`
# in the response) instead of being sent.
# Encrypts the stored WhatsApp access token. Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
WHATSAPP_ENABLED=false
# META_CLOUD or CONSOLE (default CONSOLE unless an access token is set)
WHATSAPP_PROVIDER=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=carelink_otp
WHATSAPP_TEMPLATE_LANGUAGE=en
