{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@care-platform/shared": ["../../packages/shared/src/index.ts"],
      "@care-platform/shared/i18n": ["../../packages/shared/src/i18n/create-i18n.tsx"]
    }
  },
  "include": ["src", "jest.setup.ts"]
}
