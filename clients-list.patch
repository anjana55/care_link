+import { ThrottlerStorage } from '@nestjs/throttler';
+import { eq, sql } from 'drizzle-orm';
+import request from 'supertest';
+import { AppModule } from '../src/app.module';
+import { DRIZZLE, type Database } from '../src/database/database.module';
+import { auditLogs, users } from '../src/database/schema';
+import { SEED_PASSWORD } from './seed-password';
+
+/**
+ * End-to-end coverage for the staff Clients list (GET /clients), run against
+ * the real database (migrated + seeded, same prerequisites as app.e2e-spec.ts).
+ *
+ * Clients are created through the real public registration endpoint, so this
+ * also proves what registration stores is what staff are shown.
+ */
+const unlimitedThrottle = {
+  increment: async () => ({ totalHits: 1, timeToExpire: 0, isBlocked: false, timeToBlockExpire: 0 }),
+};
+
+describe('Clients list (e2e)', () => {
+  let app: INestApplication;
+  let db: Database;
+  let http: ReturnType<typeof request>;
+  let adminToken: string;
+  let staffToken: string;
+  let verifierToken: string;
+
+  const run = `${Date.now()}`.slice(-8);
+  // Unique, valid Sri Lankan mobile numbers (077 + 7 digits) per run, as in the WhatsApp spec.
+  const runBase = Math.floor(Date.now() / 1000) % 10_000;
+  let counter = 0;
+  const newPhone = () => `077${String(runBase * 1000 + ++counter).padStart(7, '0')}`;
+  const bearer = (t: string) => ({ Authorization: `Bearer ${t}` });
+  const login = async (email: string) =>
+    (await http.post('/auth/login').send({ email, password: SEED_PASSWORD }).expect(201)).body.accessToken as string;
+
+  let districtA: number;
+  let cityA: number;
+  let districtB: number;
+  let cityB: number;
+
+  type RegisteredClient = Awaited<ReturnType<typeof registerClient>>;
+  let guardian: RegisteredClient;
+  let self: RegisteredClient;
+  let selfToken: string; // `self` verifies their email in setup; `guardian` never does
+
+  const registerClient = async (name: string, extra: Record<string, unknown>) => {
+    const email = `client-${name}-${run}@example.com`;
+    const phone = newPhone();
+    const res = await http
+      .post('/auth/register-patient')
+      .send({
+        email,
+        password: 'SelfRegPass123',
+        fullName: `Client ${name} ${run}`,
+        phone,
+        consentAccepted: true,
+        registrantType: 'SELF',
+        recipientAge: 70,
+        recipientGender: 'FEMALE',
+        preferredContactMethod: 'EMAIL',
+        districtId: districtA,
+        cityId: cityA,
+        careNeeds: 'Needs company and help around the house.',
+        careSchedule: 'DAY',
+        careStart: 'IMMEDIATELY',
+        ...extra,
+      })
+      .expect(201);
+    return { id: res.body.patientId as string, email, phone, verificationUrl: res.body.devVerificationUrl as string };
+  };
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({ imports: [AppModule] })
+      .overrideProvider(ThrottlerStorage)
+      .useValue(unlimitedThrottle)
+      .compile();
+    app = moduleRef.createNestApplication();
+    app.useGlobalPipes(new ValidationPipe({ whitelist: true, transform: true }));
+    await app.init();
+    db = app.get<Database>(DRIZZLE);
+    http = request(app.getHttpServer());
+
+    adminToken = await login('admin@care-platform.local');
+    staffToken = await login('staff@care-platform.local');
+    verifierToken = await login('verifier@care-platform.local');
+
+    const districts = ((await http.get('/public/meta/locations/tree?locale=en').expect(200)).body as { districts: { id: number }[] }[]).flatMap((p) => p.districts);
+    districtA = districts[0].id;
+    districtB = districts[1].id;
+    cityA = (await http.get(`/public/meta/locations/cities?districtId=${districtA}&locale=en`)).body[0].id;
+    cityB = (await http.get(`/public/meta/locations/cities?districtId=${districtB}&locale=en`)).body[0].id;
+
+    guardian = await registerClient('guardian', {
+      registrantType: 'GUARDIAN',
+      recipientName: `Recipient ${run}`,
+      recipientRelationship: 'PARENT',
+      recipientAge: 82,
+      recipientGender: 'MALE',
+      alternatePhone: '0112345678',
+      preferredContactMethod: 'PHONE_CALL',
+      preferredContactTime: 'EVENING',
+      districtId: districtB,
+      cityId: cityB,
+      careAddress: '12 Temple Road',
+      careSchedule: 'LIVE_IN_24H',
+      careStart: 'WITHIN_MONTH',
+      preferredCaregiverGender: 'FEMALE',
+    });
+    self = await registerClient('self', {});
+    const ver = await http.post('/auth/verify-email').send({ token: new URL(self.verificationUrl).searchParams.get('token') }).expect(201);
+    selfToken = ver.body.accessToken;
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  describe('access', () => {
+    it('rejects unauthenticated requests', async () => {
+      await http.get('/clients').expect(401);
+    });
+
+    it('lets ADMIN and STAFF list clients', async () => {
+      await http.get('/clients').set(bearer(adminToken)).expect(200);
+      await http.get('/clients').set(bearer(staffToken)).expect(200);
+    });
+
+    it('keeps VERIFIERs out: they work caregiver documents, not client contact data', async () => {
+      await http.get('/clients').set(bearer(verifierToken)).expect(403);
+      await http.get(`/clients/${self.id}`).set(bearer(verifierToken)).expect(403);
+    });
+
+    it('keeps clients themselves out, even though they hold a valid login', async () => {
+      await http.get('/clients').set(bearer(selfToken)).expect(403);
+      await http.get(`/clients/${self.id}`).set(bearer(selfToken)).expect(403);
+    });
+  });
+
+  describe('what staff see', () => {
+    const find = async (search: string, query = '') =>
+      (await http.get(`/clients?search=${encodeURIComponent(search)}${query}`).set(bearer(staffToken)).expect(200)).body;
+
+    it('shows a guardian registration with every intake field, location names and unmasked contact details', async () => {
+      const { items, total } = await find(guardian.email);
+      expect(total).toBe(1);
+      expect(items[0]).toMatchObject({
+        id: guardian.id,
+        fullName: `Client guardian ${run}`,
+        email: guardian.email,
+        phone: guardian.phone,
+        alternatePhone: '0112345678',
+        registrantType: 'GUARDIAN',
+        recipientName: `Recipient ${run}`,
+        recipientRelationship: 'PARENT',
+        recipientAge: 82,
+        recipientGender: 'MALE',
+        preferredContactMethod: 'PHONE_CALL',
+        preferredContactTime: 'EVENING',
+        districtId: districtB,
+        cityId: cityB,
+        careAddress: '12 Temple Road',
+        careSchedule: 'LIVE_IN_24H',
+        careStart: 'WITHIN_MONTH',
+        preferredCaregiverGender: 'FEMALE',
+        isActive: true,
+        isVerified: false,
+      });
+      // Names come from the joined reference tables, not from the ids.
+      expect(typeof items[0].district).toBe('string');
+      expect(typeof items[0].city).toBe('string');
+      // Never leak credentials or the raw verification columns.
+      for (const secret of ['passwordHash', 'emailVerifiedAt', 'phoneVerifiedAt']) expect(items[0]).not.toHaveProperty(secret);
+    });
+
+    it('lists only clients: no staff, caregivers or admins appear', async () => {
+      const { items } = await find('', '&pageSize=100');
+      const ids = items.map((c: { userId: string }) => c.userId);
+      const rows = await db.select({ id: users.id, role: users.role }).from(users);
+      const roleOf = new Map(rows.map((r) => [r.id, r.role]));
+      expect(ids.length).toBeGreaterThan(0);
+      for (const id of ids) expect(roleOf.get(id)).toBe('PATIENT_GUARDIAN');
+    });
+
+    it('finds a client by the care recipient name and by phone', async () => {
+      expect((await find(`Recipient ${run}`)).items.map((c: any) => c.id)).toEqual([guardian.id]);
+      expect((await find(guardian.phone)).items.map((c: any) => c.id)).toContain(guardian.id);
+      expect((await find('0112345678')).items.map((c: any) => c.id)).toContain(guardian.id);
+    });
+
+    it('filters by district, city, schedule, start, contact method, registrant type and verification', async () => {
+      const ids = async (q: string) => (await find(`-${run}@`, q)).items.map((c: any) => c.id).sort();
+      expect(await ids(`&districtId=${districtB}`)).toEqual([guardian.id]);
+      expect(await ids(`&districtId=${districtA}`)).toEqual([self.id]);
+      expect(await ids(`&cityId=${cityB}`)).toEqual([guardian.id]);
+      expect(await ids('&careSchedule=LIVE_IN_24H')).toEqual([guardian.id]);
+      expect(await ids('&careStart=IMMEDIATELY')).toEqual([self.id]);
+      expect(await ids('&contactMethod=PHONE_CALL')).toEqual([guardian.id]);
+      expect(await ids('&registrantType=GUARDIAN')).toEqual([guardian.id]);
+      expect(await ids('&registrantType=SELF')).toEqual([self.id]);
+      expect(await ids('&careSchedule=NIGHT')).toEqual([]);
+    });
+
+    it('filters by whether the client has verified their email', async () => {
+      const ids = async (v: string) => (await find(`-${run}@`, `&verification=${v}`)).items.map((c: any) => c.id);
+      expect(await ids('VERIFIED')).toEqual([self.id]);
+      expect(await ids('UNVERIFIED')).toEqual([guardian.id]);
+    });
+
+    it('paginates with a correct total', async () => {
+      const page1 = await find(`-${run}@`, '&pageSize=1&page=1');
+      const page2 = await find(`-${run}@`, '&pageSize=1&page=2');
+      expect(page1).toMatchObject({ total: 2, totalPages: 2, page: 1, pageSize: 1 });
+      expect(page1.items).toHaveLength(1);
+      expect(page2.items).toHaveLength(1);
+      expect(page1.items[0].id).not.toBe(page2.items[0].id);
+    });
+
+    it('rejects invalid filter values instead of ignoring them', async () => {
+      await http.get('/clients?careSchedule=SOMETIMES').set(bearer(staffToken)).expect(400);
+      await http.get('/clients?pageSize=1000').set(bearer(staffToken)).expect(400);
+    });
+  });
+
+  describe('a single client', () => {
+    it('returns the same record the list does, and 404s for an unknown or non-client id', async () => {
+      const res = await http.get(`/clients/${guardian.id}`).set(bearer(adminToken)).expect(200);
+      expect(res.body).toMatchObject({ id: guardian.id, recipientName: `Recipient ${run}`, city: expect.any(String) });
+      await http.get('/clients/00000000-0000-0000-0000-000000000000').set(bearer(adminToken)).expect(404);
+    });
+
+    it('audits who opened a client record', async () => {
+      await http.get(`/clients/${self.id}`).set(bearer(staffToken)).expect(200);
+      await new Promise((r) => setTimeout(r, 300)); // the interceptor records without awaiting
+      const rows = await db.select().from(auditLogs).where(eq(auditLogs.entityId, self.id));
+      expect(rows.some((r) => r.action === 'VIEW_CLIENT' && r.entityType === 'Client')).toBe(true);
+    });
+  });
+
+  describe('clients who registered before the intake existed', () => {
+    it('are listed with empty intake fields instead of breaking the list', async () => {
+      const legacy = await registerClient('legacy', {});
+      await db.execute(sql`
+        UPDATE patients SET registrant_type = NULL, recipient_age = NULL, recipient_gender = NULL, preferred_contact_method = NULL,
+          district_id = NULL, city_id = NULL, care_needs = NULL, care_schedule = NULL, care_start = NULL, preferred_caregiver_gender = NULL
+        WHERE id = ${legacy.id}`);
+      const res = await http.get(`/clients?search=${encodeURIComponent(legacy.email)}`).set(bearer(staffToken)).expect(200);
+      expect(res.body.items[0]).toMatchObject({ id: legacy.id, registrantType: null, district: null, city: null, careNeeds: null, careSchedule: null });
+      // And they are not hidden by location filters they have no value for.
+      const filtered = await http.get(`/clients?search=${encodeURIComponent(legacy.email)}&districtId=${districtA}`).set(bearer(staffToken)).expect(200);
+      expect(filtered.body.items).toEqual([]);
+    });
+  });
+});
