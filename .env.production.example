# Copy this file to .env.production and fill in every value below.
# Never commit the filled-in version - .env.production is already in
# .gitignore's local-env pattern, but double check before your first
# commit on a new machine.
#
#   cp .env.production.example .env.production
#   # edit .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ---- Domain ----
# The one public host nginx answers on, and what NEXT_PUBLIC_API_URL,
# CAREGIVER_WEB_URL and PUBLIC_WEB_URL are built from below. Replace every
# occurrence of yourdomain.example with your real domain.
DOMAIN=yourdomain.example

# ---- MySQL ----
MYSQL_DATABASE=care_platform
MYSQL_USER=care_app
# Generate with: openssl rand -base64 32
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---- API ----
# Same-origin deployment via the bundled nginx (deploy/nginx.conf) means
# CORS_ORIGIN only needs the one public origin - add more, comma-
# separated, only if a frontend is ever served from a different origin.
CORS_ORIGIN=https://yourdomain.example
CAREGIVER_WEB_URL=https://yourdomain.example/staff
PUBLIC_WEB_URL=https://yourdomain.example
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE_BYTES=10485760
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- Email (SMTP) ----
# Required for real email delivery (verification emails). Works with any
# SMTP provider - a self-hosted relay, Amazon SES's SMTP interface,
# SendGrid, Mailgun, Gmail, etc. Leave SMTP_HOST blank to defer this: the
# app still starts and runs, but verification emails only get logged to
# `docker compose logs api`, not delivered - see DEPLOYMENT.md Part 8.4.
SMTP_HOST=
SMTP_PORT=587
# "true" only for a provider that needs implicit TLS on connect (usually
# port 465). Leave "false" for STARTTLS on 587, which is what most
# providers, including the ones named above, expect.
SMTP_SECURE=false
# Leave both blank only if your relay genuinely accepts mail with no
# authentication (e.g. a private relay that only listens on localhost).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CareLink <no-reply@yourdomain.example>"

# ---- WhatsApp sign-in (optional) ----
# Lets caregivers and customers without an email address register and sign in
# with a WhatsApp one-time code. Email/password sign-in is unaffected either
# way. The feature is OFF until an admin switches it on under Settings >
# WhatsApp sign-in, which is also where credentials, the message template and
# OTP rules are managed day to day - so everything below except
# SETTINGS_ENCRYPTION_KEY can stay blank. The WHATSAPP_* values only seed those
# settings the first time the API starts; changing them later has no effect.
# Encrypts the stored WhatsApp access token. Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=META_CLOUD
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=carelink_otp
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Frontends ----
# Baked into the client bundle at image build time (see apps/web and
# apps/public-web Dockerfiles) - changing this requires a rebuild, not
# just a container restart.
NEXT_PUBLIC_API_URL=https://yourdomain.example/api
