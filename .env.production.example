# Copy this file to .env.production and fill in every value below.
# Never commit the filled-in version - .env.production is already in
# .gitignore's local-env pattern, but double check before your first
# commit on a new machine.
#
#   cp .env.production.example .env.production
#   # edit .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ---- Domain ----
# The one public host nginx answers on, and what NEXT_PUBLIC_API_URL,
# CAREGIVER_WEB_URL and PUBLIC_WEB_URL are built from below. Replace every
# occurrence of yourdomain.example with your real domain.
DOMAIN=yourdomain.example

# ---- MySQL ----
MYSQL_DATABASE=care_platform
MYSQL_USER=care_app
# Generate with: openssl rand -base64 32
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---- API ----
# Same-origin deployment via the bundled nginx (deploy/nginx.conf) means
# CORS_ORIGIN only needs the one public origin - add more, comma-
# separated, only if a frontend is ever served from a different origin.
CORS_ORIGIN=https://yourdomain.example
CAREGIVER_WEB_URL=https://yourdomain.example/staff
PUBLIC_WEB_URL=https://yourdomain.example
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE_BYTES=10485760
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---- Email (SMTP) ----
# Leave all of these blank. The mail server is set up in the app by an admin,
# under Settings > Email (host, port, credentials, sender, and a "send test
# email" button) - see DEPLOYMENT.md Part 8.4. Until then emails are written to
# `docker compose logs api` instead of being sent.
#
# Filled in, these only PRE-FILL that screen the first time the API starts (so a
# server upgraded from an older version keeps sending); after that the Settings
# screen is the source of truth and editing these has no effect. The password is
# stored encrypted with SETTINGS_ENCRYPTION_KEY below.
SMTP_HOST=
SMTP_PORT=587
# "true" only for a provider that needs implicit TLS on connect (usually
# port 465). Leave "false" for STARTTLS on 587, which is what most
# providers expect.
SMTP_SECURE=false
# Leave both blank only if your relay genuinely accepts mail with no
# authentication (e.g. a private relay that only listens on localhost).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CareLink <no-reply@yourdomain.example>"

# ---- WhatsApp sign-in (optional) ----
# Lets caregivers and customers without an email address register and sign in
# with a WhatsApp one-time code. Email/password sign-in is unaffected either
# way. The feature is OFF until an admin switches it on under Settings >
# WhatsApp sign-in, which is also where credentials, the message template and
# OTP rules are managed day to day - so everything below except
# SETTINGS_ENCRYPTION_KEY can stay blank. The WHATSAPP_* values only seed those
# settings the first time the API starts; changing them later has no effect.
# Encrypts the secrets admins save under Settings (the WhatsApp access token,
# the email server password, social sign-in secrets). Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=META_CLOUD
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=carelink_otp
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Google / Microsoft / Facebook sign-in (optional) ----
# Offered to caregivers on /caregiver/signup (after the form) and on the sign-in page.
#
# These variables are only a STARTING POINT. Once the app is running, an admin
# manages each provider under Settings > Social sign-in (on/off, client ID,
# client secret, Microsoft tenant, Facebook API version, and a "test credentials"
# button). The first time the API needs a provider it seeds that screen from the
# values below, so an existing deployment keeps working; after that the database
# is the source of truth and editing these has no effect. Leave them blank to
# configure everything from the Settings screen.
#
# Each provider's console must have this exact redirect URI registered (the
# Settings screen shows the same values, with a copy button):
#   {SOCIAL_AUTH_CALLBACK_BASE_URL}/auth/social/google/callback
#   {SOCIAL_AUTH_CALLBACK_BASE_URL}/auth/social/microsoft/callback
#   {SOCIAL_AUTH_CALLBACK_BASE_URL}/auth/social/facebook/callback
# A mismatch is rejected at the token exchange, so it must match byte for byte.
# Secrets are stored encrypted with SETTINGS_ENCRYPTION_KEY - set it, and do not
# change it later, or stored secrets become unreadable and must be re-entered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# 'common' = any Microsoft work/school or personal account, 'organizations' =
# work/school only, 'consumers' = personal accounts only.
MICROSOFT_TENANT=common
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# The public origin the providers send the caregiver back to. Behind nginx that
# is https://yourdomain.example/api - nginx strips the /api prefix before
# proxying to the API, but the redirect_uri sent to the provider still has to
# carry it. Leave blank to use {NEXT_PUBLIC_API_URL}.
SOCIAL_AUTH_CALLBACK_BASE_URL=https://yourdomain.example/api

# ---- Frontends ----
# Baked into the client bundle at image build time (see apps/web and
# apps/public-web Dockerfiles) - changing this requires a rebuild, not
# just a container restart.
NEXT_PUBLIC_API_URL=https://yourdomain.example/api

# ---- Sign-in portals ----
# POST /auth/login takes an optional `portal` (staff | caregiver | customer) and refuses
# credentials that belong to another portal exactly like a wrong password. Leave this
# unset while older web builds may still be in use; once every client sends the portal,
# set it to true and a sign-in without one is rejected.
# AUTH_REQUIRE_LOGIN_PORTAL=true
